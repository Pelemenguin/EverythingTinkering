{
    "json.schemas": [
        {
            "fileMatch": [
                "/lang/*.json"
            ],
            "url": "./.vscode/probe.lang-schema.json"
        },
        {
            "fileMatch": [
                "/probe/docs/*.json"
            ],
            "url": "./.vscode/probe.doc-schema.json"
        },
        {
            "fileMatch": [
                "/data/*/recipes/**/*.json"
            ],
            "url": "./.vscode/modpack.schema.recipe.json"
        }
    ],
    "python.analysis.typeCheckingMode": "standard"
}